generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String   @id
  email     String   @unique
  name      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  rooms     Room[]   @relation("RoomHost")
  schedules Schedule[]
}

model Room {
  id          String       @id @default(uuid())
  slug        String       @unique
  hostId      String
  host        User         @relation("RoomHost", fields: [hostId], references: [id], onDelete: Cascade)
  isActive    Boolean      @default(true)
  createdAt   DateTime     @default(now())
  endedAt     DateTime?
  logs        MeetingLog[]
  transcripts MeetingTranscript[]
  aiNote      MeetingNote?
}

model MeetingTranscript {
  id        String   @id @default(uuid())
  roomId    String
  speaker   String
  text      String   @db.Text
  timestamp DateTime @default(now())
  room      Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)

  @@index([roomId, timestamp])
}

model MeetingNote {
  id          String   @id @default(uuid())
  roomId      String   @unique
  summary     String   @db.Text
  keyPoints   String[]
  actionItems String[]
  decisions   String[]
  fullText    String   @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  room        Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)
}

model MeetingLog {
  id        String   @id @default(uuid())
  roomId    String
  room      Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)
  type      LogType  @default(SUMMARY)
  content   String   @db.Text
  createdAt DateTime @default(now())
}

enum LogType {
  ACTION
  SUMMARY
  SYSTEM
}

model Schedule {
  id          String   @id @default(uuid())
  title       String
  description String?
  startTime   DateTime
  duration    Int
  hostId      String
  host        User     @relation(fields: [hostId], references: [id], onDelete: Cascade)
  roomSlug    String?  @unique
  createdAt   DateTime @default(now())
}
